        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="(2) The holder is entitled to investment credit for the Financial Year " + Fields!INVESTMENT_YEAR.Value + " under section 76 and section 78 of part-C, of the Sixth Schedule of the Income Tax Act-2023."</Value>
                <Style>
