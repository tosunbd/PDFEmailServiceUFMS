      <Textbox Name="Textbox25">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="This is to certify that the Corporation has issued ICB Unit Certificates under CIP against the net dividend income for the financial year ended "+Fields!YEAR_END_DATE_STR.Value+" to the above unit holder. The particulars are as follows:"</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Textbox25</rd:DefaultName>
        <Top>3.04931in</Top>
        <Left>0.30312in</Left>
